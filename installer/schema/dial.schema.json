{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DIAL installation config (dial/v1)",
  "description": "Single configuration file for dial-install. Generated by `dial-install init`; safe to edit by hand.",
  "type": "object",
  "required": [
    "apiVersion",
    "name",
    "aws",
    "domain",
    "secrets"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "dial/v1"
    },
    "release": {
      "type": "string",
      "description": "DIAL release to install: `latest` (the newest release in this package) or a release id such as 2026.10.1. Every component version comes from the release."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,20}$",
      "description": "Short installation name (2-21 chars). Prefix of every CloudFormation stack and the EKS cluster name."
    },
    "aws": {
      "type": "object",
      "required": [
        "region"
      ],
      "additionalProperties": false,
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$",
          "description": "Optional safety net. `check` fails when the active credentials belong to another account."
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "certificate_arn"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "base"
          ]
        },
        {
          "required": [
            "hosts"
          ],
          "properties": {
            "hosts": {
              "required": [
                "chat",
                "admin",
                "core",
                "themes",
                "grafana",
                "superset"
              ]
            }
          }
        }
      ],
      "properties": {
        "base": {
          "type": "string",
          "description": "Base domain. Every host not listed under `hosts` becomes <service>.<base>."
        },
        "certificate_arn": {
          "type": "string",
          "pattern": "^arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/.+$",
          "description": "ISSUED ACM certificate in the same account and region. It must cover every final host name."
        },
        "hosts": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional per-service host name overrides (full host names).",
          "properties": {
            "chat": {
              "type": "string"
            },
            "admin": {
              "type": "string"
            },
            "core": {
              "type": "string"
            },
            "themes": {
              "type": "string"
            },
            "grafana": {
              "type": "string"
            },
            "superset": {
              "type": "string"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "arn"
      ],
      "additionalProperties": false,
      "properties": {
        "arn": {
          "type": "string",
          "pattern": "^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+$",
          "description": "The single Secrets Manager secret created by the customer. `check` verifies every required key is present."
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "create",
            "existing-vpc",
            "shared-vpc"
          ],
          "default": "create"
        },
        "cidr": {
          "type": "string",
          "description": "VPC CIDR. Only for provider `create`. Default 10.0.0.0/16."
        },
        "subnet_cidrs": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only for provider `create`. Required when `cidr` is not a /16.",
          "properties": {
            "public": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "private": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "vpc_id": {
          "type": "string",
          "pattern": "^vpc-[0-9a-f]+$"
        },
        "subnets": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only for existing-vpc / shared-vpc. Two subnets in two different Availability Zones each.",
          "properties": {
            "public": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^subnet-[0-9a-f]+$"
              },
              "minItems": 2
            },
            "private": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^subnet-[0-9a-f]+$"
              },
              "minItems": 2
            }
          },
          "required": [
            "private"
          ]
        },
        "exposure": {
          "enum": [
            "internal",
            "public"
          ],
          "default": "internal",
          "description": "Load balancer scheme. `public` needs public subnets."
        },
        "create_vpc_endpoints": {
          "type": "boolean",
          "description": "Create the VPC endpoints EKS needs. Default: true for `create`, false for existing/shared VPCs."
        },
        "allowed_cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "Source networks allowed to reach the load balancer on HTTPS (up to 5). Default: 0.0.0.0/0."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "enum": [
                  "existing-vpc",
                  "shared-vpc"
                ]
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "vpc_id",
              "subnets"
            ]
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "cognito",
            "cognito-saml"
          ],
          "default": "cognito"
        },
        "self_registration": {
          "type": "boolean",
          "default": false
        },
        "user_pool_name": {
          "type": "string",
          "default": "dial-users"
        },
        "hosted_ui_domain_prefix": {
          "type": "string",
          "description": "Cognito hosted UI prefix. Default: dial-users-<account id>."
        },
        "saml": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_name",
            "metadata_url"
          ],
          "properties": {
            "provider_name": {
              "type": "string"
            },
            "metadata_url": {
              "type": "string",
              "pattern": "^https://.+"
            },
            "idp_signout": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "cognito-saml"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "saml"
            ]
          }
        }
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "aurora-create"
          ],
          "default": "aurora-create"
        },
        "engine_version": {
          "type": "string",
          "description": "Aurora PostgreSQL engine version. Default comes from release.yaml."
        },
        "min_capacity": {
          "type": "number",
          "default": 1,
          "description": "Aurora Serverless v2 minimum ACU."
        },
        "max_capacity": {
          "type": "number",
          "default": 4,
          "description": "Aurora Serverless v2 maximum ACU."
        },
        "backup_retention_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Days automated backups are kept (1-35). Default 7."
        },
        "deletion_protection": {
          "type": "boolean",
          "default": true,
          "description": "Refuse to delete the database while enabled."
        },
        "auth": {
          "enum": [
            "password",
            "iam"
          ],
          "default": "password",
          "description": "How DIAL Admin signs in to the database: `password` (the master user) or `iam` (its IAM role; no password, short-lived tokens)."
        },
        "iam_user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,62}$",
          "default": "dial_admin_iam",
          "description": "PostgreSQL role used with auth `iam`."
        },
        "bootstrap_image": {
          "type": "string",
          "description": "Advanced, auth `iam`: image with psql for the one-time role creation. Default comes from the platform chart."
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$",
          "description": "EKS version. Default comes from release.yaml."
        },
        "cni": {
          "enum": ["vpc-cni", "cilium"],
          "default": "vpc-cni",
          "description": "Network plugin. `vpc-cni` gives pods VPC addresses (default). `cilium` uses an overlay network (VXLAN) with its own pod range; load balancers then target nodes instead of pods."
        },
        "pod_cidr": {
          "type": "string",
          "description": "Only with cni `cilium`: the overlay range for pods. Default 100.96.0.0/18. It must not overlap the VPC or any network you connect to it."
        },
        "public_endpoint": {
          "type": "boolean",
          "default": true,
          "description": "Reachable from the internet (still protected by IAM). Set false to make the API private; then run the installer from inside the VPC."
        },
        "admin_arns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:(user|role)/.+$"
          },
          "description": "IAM users or roles that get cluster-admin access to the cluster, in addition to whoever runs the installation."
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_groups": {
          "type": "object",
          "description": "Optional per node group overrides. Defaults come from release.yaml.",
          "additionalProperties": false,
          "properties": {
            "core": {
              "$ref": "#/$defs/nodegroup"
            },
            "rag": {
              "$ref": "#/$defs/nodegroup"
            },
            "dynamic": {
              "$ref": "#/$defs/nodegroup"
            },
            "system": {
              "$ref": "#/$defs/nodegroup"
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analytics": {
          "type": "boolean",
          "default": true,
          "description": "Superset, Grafana, InfluxDB."
        },
        "deployment_manager": {
          "type": "boolean",
          "default": true
        },
        "container_logs": {
          "type": "boolean",
          "default": true,
          "description": "Send container logs and metrics to CloudWatch (Container Insights)."
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Tags added to every AWS resource the installer creates (for cost allocation, ownership, ...)."
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "ecr-mirror",
            "public"
          ],
          "default": "ecr-mirror",
          "description": "`ecr-mirror` copies the product images from the AWS Marketplace registry into your own private ECR during install and upgrade, and the cluster pulls from there. `public` pulls directly from the Marketplace registry."
        },
        "source": {
          "type": "string",
          "pattern": "^oci://[a-z0-9.-]+(:[0-9]+)?/.+[^/]$",
          "description": "Where the platform chart and the product images are published: oci://<registry host>/<repository prefix>. Default comes from installer.yaml. Set it to use another AWS account."
        }
      }
    }
  },
  "$defs": {
    "nodegroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_type": {
          "type": "string"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "desired": {
          "type": "integer",
          "minimum": 0
        },
        "disk_gb": {
          "type": "integer",
          "minimum": 20,
          "description": "Root volume size. Core node group only."
        }
      }
    }
  }
}
